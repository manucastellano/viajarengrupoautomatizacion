<!doctype html><html lang="es"><head><meta charset="utf-8"><link rel="stylesheet" href="{{ raiz }}/base.css"><style>
.f{position:absolute;display:grid;gap:4px}
.f.arriba{top:260px;right:110px;text-align:right}.f.abajo{bottom:330px;left:110px}
.anio{font-size:52px}.lugar{font-size:62px}
</style></head><body><div class="lienzo v"><div class="foto"{% if foto %} style="background-image:url('{{ foto }}')"{% endif %}></div>{% if esquina == 'abajo' %}<div class="velo-abajo"></div>{% endif %}
<div class="f sombra {{ 'abajo' if esquina == 'abajo' else 'arriba' }}"><p class="txt anio">{{ anio }}</p><p class="disp lugar">{{ lugar }}</p></div>
</div></body></html>
